const SHEET_NAME = 'Data';
const CUSTOM_SHEET_NAME = 'CustomExercises';
const MAX_FAILED_ATTEMPTS = 5;
const LOCKOUT_SECONDS = 300;

// Column layout (0-based):
// 0=Date, 1=Time, 2=Type, 3=Reps, 4=Sets, 5=Weight, 6=Energy,
// 7=Body Weight, 8=How Long, 9=Volume, 10=User, 11=Group, 12=Id
const ID_COL_INDEX = 12;

// CustomExercises sheet columns (0-based):
// 0=Id, 1=Name, 2=Group, 3=ImageUrl, 4=PrimaryMuscle, 5=SecondaryMuscles, 6=AddedBy, 7=DateAdded

function getSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(SHEET_NAME) || ss.getSheets()[0];
}

// Auto-creates the CustomExercises tab (with headers) the first time it's needed,
// so there's no manual setup step for this feature.
function getCustomSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(CUSTOM_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(CUSTOM_SHEET_NAME);
    sheet.appendRow(['Id', 'Name', 'Group', 'ImageUrl', 'PrimaryMuscle', 'SecondaryMuscles', 'AddedBy', 'DateAdded']);
  }
  return sheet;
}
function getSecret_() {
  return PropertiesService.getScriptProperties().getProperty('SECRET');
}
function tooManyAttempts_() {
  const cache = CacheService.getScriptCache();
  return Number(cache.get('failed_attempts') || 0) >= MAX_FAILED_ATTEMPTS;
}
function recordFailedAttempt_() {
  const cache = CacheService.getScriptCache();
  const attempts = Number(cache.get('failed_attempts') || 0);
  cache.put('failed_attempts', String(attempts + 1), LOCKOUT_SECONDS);
}
function resetAttempts_() {
  CacheService.getScriptCache().remove('failed_attempts');
}
function jsonOut_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
function checkAuth_(token) {
  if (tooManyAttempts_()) {
    return { ok: false, error: 'locked_out' };
  }
  if (token !== getSecret_()) {
    recordFailedAttempt_();
    return { ok: false, error: 'unauthorized' };
  }
  resetAttempts_();
  return { ok: true };
}

// Returns the 1-based sheet row number for a given entry id, or -1 if not found.
function findRowIndexById_(sheet, id) {
  if (!id) return -1;
  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i++) { // skip header row
    if (values[i][ID_COL_INDEX] === id) return i + 1; // sheet rows are 1-based
  }
  return -1;
}

function rowValuesFromPayload_(payload) {
  const reps = parseFloat(payload.reps) || 0;
  const sets = parseFloat(payload.sets) || 0;
  const weight = parseFloat(payload.weight) || 0;
  const volume = reps * sets * weight;
  return [
    payload.date || '',
    payload.time || '',
    payload.exercise || '',
    payload.reps || '',
    payload.sets || '',
    payload.weight || '',
    payload.energy || '',
    payload.bodyweight || '',
    payload.howlong || '',
    volume,
    payload.user || '',
    payload.group || '',
    payload.id || '',
  ];
}

function createEntry_(payload) {
  const sheet = getSheet_();
  sheet.appendRow(rowValuesFromPayload_(payload));
  return jsonOut_({ ok: true });
}

function updateEntry_(payload) {
  const sheet = getSheet_();
  const rowNum = findRowIndexById_(sheet, payload.id);
  if (rowNum === -1) return jsonOut_({ ok: false, error: 'not_found' });
  const values = rowValuesFromPayload_(payload);
  sheet.getRange(rowNum, 1, 1, values.length).setValues([values]);
  return jsonOut_({ ok: true });
}

function deleteEntry_(payload) {
  const sheet = getSheet_();
  const rowNum = findRowIndexById_(sheet, payload.id);
  if (rowNum === -1) return jsonOut_({ ok: false, error: 'not_found' });
  sheet.deleteRow(rowNum);
  return jsonOut_({ ok: true });
}

// CustomExercises id column (0-based) — a separate index from the log's ID_COL_INDEX
const CUSTOM_ID_COL_INDEX = 0;

// Returns the 1-based sheet row number for a given custom-exercise id, or -1 if not found.
function findCustomRowIndexById_(sheet, id) {
  if (!id) return -1;
  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i++) { // skip header row
    if (values[i][CUSTOM_ID_COL_INDEX] === id) return i + 1;
  }
  return -1;
}

function customRowValuesFromPayload_(payload) {
  return [
    payload.id || '',
    payload.name || '',
    payload.group || '',
    payload.imageUrl || '',
    payload.primaryMuscle || '',
    payload.secondaryMuscles || '',
    payload.user || '',
    payload.date || '',
  ];
}

function addCustomExercise_(payload) {
  const sheet = getCustomSheet_();
  sheet.appendRow(customRowValuesFromPayload_(payload));
  return jsonOut_({ ok: true });
}

function updateCustomExercise_(payload) {
  const sheet = getCustomSheet_();
  const rowNum = findCustomRowIndexById_(sheet, payload.id);
  if (rowNum === -1) return jsonOut_({ ok: false, error: 'not_found' });
  const values = customRowValuesFromPayload_(payload);
  sheet.getRange(rowNum, 1, 1, values.length).setValues([values]);
  return jsonOut_({ ok: true });
}

function deleteCustomExercise_(payload) {
  const sheet = getCustomSheet_();
  const rowNum = findCustomRowIndexById_(sheet, payload.id);
  if (rowNum === -1) return jsonOut_({ ok: false, error: 'not_found' });
  sheet.deleteRow(rowNum);
  return jsonOut_({ ok: true });
}

function doGet(e) {
  const auth = checkAuth_(e.parameter.token);
  if (!auth.ok) return jsonOut_(auth);

  if (e.parameter.action === 'ping') {
    return jsonOut_({ ok: true });
  }

  if (e.parameter.action === 'customExercises') {
    const sheet = getCustomSheet_();
    const rows = sheet.getDataRange().getValues();
    return jsonOut_({ ok: true, rows: rows });
  }

  const sheet = getSheet_();
  const rows = sheet.getDataRange().getValues();
  return jsonOut_({ ok: true, rows: rows });
}

function doPost(e) {
  let payload;
  try {
    payload = JSON.parse(e.postData.contents);
  } catch (err) {
    return jsonOut_({ ok: false, error: 'bad_request' });
  }
  const auth = checkAuth_(payload.token);
  if (!auth.ok) return jsonOut_(auth);

  const op = payload.op || 'create';
  if (op === 'update') return updateEntry_(payload);
  if (op === 'delete') return deleteEntry_(payload);
  if (op === 'addCustomExercise') return addCustomExercise_(payload);
  if (op === 'updateCustomExercise') return updateCustomExercise_(payload);
  if (op === 'deleteCustomExercise') return deleteCustomExercise_(payload);
  return createEntry_(payload);
}
