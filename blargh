const SHEET_NAME = 'Data';
const MAX_FAILED_ATTEMPTS = 5;
const LOCKOUT_SECONDS = 300;
const EXERCISE_LIST_CACHE_SECONDS = 21600; // 6 hours

function getSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(SHEET_NAME) || ss.getSheets()[0];
}
function getSecret_() {
  return PropertiesService.getScriptProperties().getProperty('SECRET');
}
function tooManyAttempts_() {
  const cache = CacheService.getScriptCache();
  return Number(cache.get('failed_attempts') || 0) >= MAX_FAILED_ATTEMPTS;
}
function recordFailedAttempt_() {
  const cache = CacheService.getScriptCache();
  const attempts = Number(cache.get('failed_attempts') || 0);
  cache.put('failed_attempts', String(attempts + 1), LOCKOUT_SECONDS);
}
function resetAttempts_() {
  CacheService.getScriptCache().remove('failed_attempts');
}
function jsonOut_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
function checkAuth_(token) {
  if (tooManyAttempts_()) {
    return { ok: false, error: 'locked_out' };
  }
  if (token !== getSecret_()) {
    recordFailedAttempt_();
    return { ok: false, error: 'unauthorized' };
  }
  resetAttempts_();
  return { ok: true };
}
function getExerciseData_(name) {
  const key = PropertiesService.getScriptProperties().getProperty('RAPIDAPI_KEY');
  const url = 'https://exercisedb.p.rapidapi.com/exercises/name/'
              + encodeURIComponent(name.toLowerCase()) + '?limit=1';
  const response = UrlFetchApp.fetch(url, {
    headers: {
      'X-RapidAPI-Key': key,
      'X-RapidAPI-Host': 'exercisedb.p.rapidapi.com'
    }
  });
  return JSON.parse(response.getContentText());
}

// Returns just the exercise names for a single ExerciseDB bodyPart value
// (e.g. "chest", "upper legs"), cached for a few hours so repeated tab
// switches don't re-hit RapidAPI every time.
function getExerciseNamesForBodyPart_(bodypart) {
  const cache = CacheService.getScriptCache();
  const cacheKey = 'bodypart_names_' + bodypart;
  const cached = cache.get(cacheKey);
  if (cached) return JSON.parse(cached);

  const key = PropertiesService.getScriptProperties().getProperty('RAPIDAPI_KEY');
  const url = 'https://exercisedb.p.rapidapi.com/exercises/bodyPart/'
              + encodeURIComponent(bodypart) + '?limit=200';
  const response = UrlFetchApp.fetch(url, {
    headers: {
      'X-RapidAPI-Key': key,
      'X-RapidAPI-Host': 'exercisedb.p.rapidapi.com'
    }
  });
  const data = JSON.parse(response.getContentText());
  const names = Array.from(new Set(data.map(function (ex) { return ex.name; }))).sort();

  cache.put(cacheKey, JSON.stringify(names), EXERCISE_LIST_CACHE_SECONDS);
  return names;
}

// Accepts a comma-separated list of bodyPart values (e.g. "upper legs,lower legs")
// and returns the merged, deduped, sorted list of exercise names across all of them.
function getExerciseNamesForBodyParts_(bodypartsParam) {
  const parts = (bodypartsParam || '')
    .split(',')
    .map(function (s) { return s.trim(); })
    .filter(Boolean);

  const all = [];
  parts.forEach(function (bp) {
    all.push.apply(all, getExerciseNamesForBodyPart_(bp));
  });
  return Array.from(new Set(all)).sort();
}

function doGet(e) {
  const auth = checkAuth_(e.parameter.token);
  if (!auth.ok) return jsonOut_(auth);

  if (e.parameter.action === 'ping') {
    return jsonOut_({ ok: true });
  }

  if (e.parameter.action === 'exercise') {
    const data = getExerciseData_(e.parameter.name);
    return jsonOut_({ ok: true, exercise: data[0] || null });
  }

  if (e.parameter.action === 'exerciseList') {
    const names = getExerciseNamesForBodyParts_(e.parameter.bodypart);
    return jsonOut_({ ok: true, names: names });
  }

  const sheet = getSheet_();
  const rows = sheet.getDataRange().getValues();
  return jsonOut_({ ok: true, rows: rows });
}

function doPost(e) {
  let payload;
  try {
    payload = JSON.parse(e.postData.contents);
  } catch (err) {
    return jsonOut_({ ok: false, error: 'bad_request' });
  }
  const auth = checkAuth_(payload.token);
  if (!auth.ok) return jsonOut_(auth);
  const sheet = getSheet_();
  const reps = parseFloat(payload.reps) || 0;
  const sets = parseFloat(payload.sets) || 0;
  const weight = parseFloat(payload.weight) || 0;
  const volume = reps * sets * weight;
  sheet.appendRow([
    payload.date || '',
    payload.time || '',
    payload.exercise || '',
    payload.reps || '',
    payload.sets || '',
    payload.weight || '',
    payload.energy || '',
    payload.bodyweight || '',
    payload.howlong || '',
    volume,
    payload.user || '',
    payload.group || '',
  ]);
  return jsonOut_({ ok: true });
}
