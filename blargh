// Workout Log — Apps Script backend (single shared PIN, profile tag)
// Replace your existing Code.gs with this in full.
// ====================================================================

const SHEET_NAME = 'Data';          // <-- your actual tab name
const MAX_FAILED_ATTEMPTS = 5;      // lockout threshold
const LOCKOUT_SECONDS = 300;        // 5 minutes

// Falls back to the first sheet if SHEET_NAME ever stops matching a real
// tab (e.g. someone renames it later) instead of failing silently.
function getSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(SHEET_NAME) || ss.getSheets()[0];
}

// ---- Setup ----
// Project Settings (gear icon) > Script Properties > Add property
//   Key:   SECRET
//   Value: the one shared PIN everyone uses

function getSecret_() {
  return PropertiesService.getScriptProperties().getProperty('SECRET');
}

function tooManyAttempts_() {
  const cache = CacheService.getScriptCache();
  return Number(cache.get('failed_attempts') || 0) >= MAX_FAILED_ATTEMPTS;
}

function recordFailedAttempt_() {
  const cache = CacheService.getScriptCache();
  const attempts = Number(cache.get('failed_attempts') || 0);
  cache.put('failed_attempts', String(attempts + 1), LOCKOUT_SECONDS);
}

function resetAttempts_() {
  CacheService.getScriptCache().remove('failed_attempts');
}

function jsonOut_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function checkAuth_(token) {
  if (tooManyAttempts_()) {
    return { ok: false, error: 'locked_out' };
  }
  if (token !== getSecret_()) {
    recordFailedAttempt_();
    return { ok: false, error: 'unauthorized' };
  }
  resetAttempts_();
  return { ok: true };
}

// ---- GET: ping (PIN check) or fetch all rows ----
// Note: with one shared PIN, this returns everyone's rows — filtering by
// the selected profile happens client-side, not here.
function doGet(e) {
  const auth = checkAuth_(e.parameter.token);
  if (!auth.ok) return jsonOut_(auth);

  if (e.parameter.action === 'ping') {
    return jsonOut_({ ok: true });
  }

  const sheet = getSheet_();
  const rows = sheet.getDataRange().getValues();
  return jsonOut_({ ok: true, rows: rows });
}

// ---- POST: log a workout, tagged with whichever profile was selected ----
function doPost(e) {
  let payload;
  try {
    payload = JSON.parse(e.postData.contents);
  } catch (err) {
    return jsonOut_({ ok: false, error: 'bad_request' });
  }

  const auth = checkAuth_(payload.token);
  if (!auth.ok) return jsonOut_(auth);

  const sheet = getSheet_();
  const reps = parseFloat(payload.reps) || 0;
  const sets = parseFloat(payload.sets) || 0;
  const weight = parseFloat(payload.weight) || 0;
  const volume = reps * sets * weight;

  sheet.appendRow([
    payload.date || '',
    payload.time || '',
    payload.exercise || '',
    payload.reps || '',
    payload.sets || '',
    payload.weight || '',
    payload.energy || '',
    payload.bodyweight || '',
    payload.howlong || '',
    volume,                // auto-calculated, not client-supplied
    payload.user || '',    // client-selected profile, not server-verified
    payload.group || '',   // muscle group tab active when logged
  ]);

  return jsonOut_({ ok: true });
}
